# ============================================================
#  Copie para .env e ajuste:   cp .env.example .env
#  NUNCA faca commit do .env (ja esta no .gitignore)
# ============================================================

# ---- Identificacao do ambiente ----
COMPOSE_PROJECT_NAME=aguiaradar
APP_ENV=local
SPRING_PROFILES_ACTIVE=dev
APP_VERSION=local
APP_PORT=8080

# ---- MongoDB (container do compose) ----
MONGO_USER=aguiaradar
MONGO_PASSWORD=troque-esta-senha
MONGO_DB=aguiaradar
MONGO_PORT=27017

# ---- Seguranca (JWT) ----
# Precisa ser Base64 valido (>= 32 bytes). Gere a SUA com:  openssl rand -base64 48
JWT_SECRET=60j2h4qV+MwjYkiMHKJAJBnu9brBjzZ0L3+NiH/gsBBKgSd7ZFfMGnfDlQlEZzFt
JWT_EXPIRATION_MS=86400000

# ---- Dados de demonstracao ----
SEED_ENABLED=true

# ---- IA (opcional; sem chave usa o fallback heuristico) ----
IA_ENABLED=true
IA_API_KEY=
IA_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
IA_MODEL=meta-llama/llama-3.1-8b-instruct:free
